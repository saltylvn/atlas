{
  "manifest_version": 3,
  "name": "Atlas Autofill",
  "version": "1.0.0",
  "description": "Fills job application forms from your Atlas answer bank when you press Fill. You review and submit.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png" },
  "action": {
    "default_title": "Fill with Atlas",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://atlas-optim.vercel.app/applications*"],
      "js": ["sync.js"],
      "run_at": "document_idle"
    }
  ]
}
