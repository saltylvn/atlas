# Copy to .env.local for development. Never commit real values.
# With no Supabase values, `npm run dev` runs in demo mode (fictional data, in memory).

# --- Database and sign-in (live mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The only account allowed in. Must match private.config owner_email in the database.
ATLAS_OWNER_EMAIL=
# Server-only. Used by Gmail sync, the scheduled briefs, job matches and capture.
SUPABASE_SECRET_KEY=
# Your Supabase auth user id (Authentication > Users), for rows scheduled jobs write.
ATLAS_OWNER_USER_ID=

# --- AI (optional; without it the brief and drafts are rules-based) ---
ANTHROPIC_API_KEY=
# Google Gemini instead of (or alongside) Claude. Create the key in Google AI Studio on a
# project with billing on: free-tier prompts may be used to improve Google's products.
GEMINI_API_KEY=
# Which one runs when both keys are set: anthropic or gemini. Unset = Claude first.
ATLAS_AI_PROVIDER=
# Optional model overrides (defaults: gemini-3.5-flash-lite and gemini-4-hydrogen).
ATLAS_GEMINI_MODEL_FAST=
ATLAS_GEMINI_MODEL_WRITER=
ATLAS_AI_DAILY_LIMIT=60

# --- Keep-alive: stops Supabase Free from pausing after 7 idle days ---
# Same value as the ATLAS_KEEPALIVE_TOKEN GitHub Actions secret. Generate: openssl rand -hex 32
ATLAS_KEEPALIVE_TOKEN=

# --- Calendar: your calendar's *secret* iCal address (treat it like a password) ---
CALENDAR_ICS_URL=

# Notion. An internal integration's secret, with "Read content". Add "Insert content"
# and "Update content" only for the resume sync (see FIGMA_TOKEN below).
# Atlas reads the Resumes database in Atlas HQ: role order and each role's resume.
# Share Atlas HQ with the integration (••• > Connections) or Atlas sees nothing.
NOTION_TOKEN=
# Optional. Without it, Atlas finds the shared database titled "Resumes".
NOTION_RESUMES_DATA_SOURCE_ID=

# Figma (read-only), for the resume sync: a personal access token with the single scope
# "File content: read". Each evening Atlas mirrors a resume that changed in Figma into its
# Notion page. Tokens expire after at most 90 days. See docs/INTEGRATIONS.md.
FIGMA_TOKEN=

# GitHub (read-only), so the Analyst can count the skills your own projects show.
# GITHUB_USER is your login; that alone reads your public repositories.
# GITHUB_TOKEN is optional, to include private ones: a fine-grained token limited to the
# repositories you choose, with Contents and Metadata set to Read-only.
GITHUB_USER=
GITHUB_TOKEN=

# --- Gmail (read-only). See docs/DEPLOY.md step 3 ---
# Your site's https address; the OAuth redirect is <ATLAS_SITE_URL>/api/connect/google/callback
ATLAS_SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored OAuth tokens. Generate: openssl rand -base64 32
ATLAS_VAULT_KEY=

# --- Morning push and Siri capture. See docs/DEPLOY.md step 4 ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vercel Cron sends this as a bearer token. Generate: openssl rand -hex 32
CRON_SECRET=
# For the "Add to Atlas" Shortcut. Generate: openssl rand -hex 32
ATLAS_CAPTURE_TOKEN=

# --- Misc ---
ATLAS_TIMEZONE=America/Denver
# Set to 1 only for a preview deploy that should run demo mode in production.
ATLAS_DEMO=
